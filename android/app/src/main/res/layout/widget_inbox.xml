<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_light_background"
    android:elevation="6dp"
    android:forceDarkAllowed="false"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/widget_add_btn"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/widget_dark_circle"
        android:text="+"
        android:textColor="@color/widget_control_text"
        android:textSize="24sp"
        android:gravity="center"
        android:contentDescription="Add Inbox task" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Inbox"
        android:textColor="@color/widget_light_text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_inbox_subtext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap to add"
        android:textColor="@color/widget_light_text_secondary"
        android:textSize="12sp"
        android:maxLines="1" />
</LinearLayout>
