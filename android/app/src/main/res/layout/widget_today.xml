<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_light_background"
    android:elevation="6dp"
    android:forceDarkAllowed="false"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Today"
            android:textColor="@color/widget_light_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_header_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_light_count_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="0/0 done"
            android:textColor="@color/widget_light_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="7dp"
        android:background="@color/widget_light_divider"
        android:text="" />

    <TextView
        android:id="@+id/widget_action_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Tap circles to complete"
        android:textColor="@color/widget_light_text_secondary"
        android:textSize="12sp"
        android:maxLines="1" />

    <LinearLayout
        android:id="@+id/widget_task_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_task1_row"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView android:id="@+id/widget_task1_checkbox" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_widget_circle_outline_light" android:contentDescription="Complete task" />
            <TextView android:id="@+id/widget_task1_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="Task title" android:textColor="@color/widget_light_text_primary" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_task1_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/widget_light_text_secondary" android:textSize="11sp" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_task2_row"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView android:id="@+id/widget_task2_checkbox" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_widget_circle_outline_light" android:contentDescription="Complete task" />
            <TextView android:id="@+id/widget_task2_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="Task title" android:textColor="@color/widget_light_text_primary" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_task2_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/widget_light_text_secondary" android:textSize="11sp" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_task3_row"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView android:id="@+id/widget_task3_checkbox" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_widget_circle_outline_light" android:contentDescription="Complete task" />
            <TextView android:id="@+id/widget_task3_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="Task title" android:textColor="@color/widget_light_text_primary" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_task3_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/widget_light_text_secondary" android:textSize="11sp" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_task4_row"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView android:id="@+id/widget_task4_checkbox" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_widget_circle_outline_light" android:contentDescription="Complete task" />
            <TextView android:id="@+id/widget_task4_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="Task title" android:textColor="@color/widget_light_text_primary" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_task4_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/widget_light_text_secondary" android:textSize="11sp" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_task5_row"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView android:id="@+id/widget_task5_checkbox" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_widget_circle_outline_light" android:contentDescription="Complete task" />
            <TextView android:id="@+id/widget_task5_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="Task title" android:textColor="@color/widget_light_text_primary" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_task5_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/widget_light_text_secondary" android:textSize="11sp" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_task6_row"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView android:id="@+id/widget_task6_checkbox" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_widget_circle_outline_light" android:contentDescription="Complete task" />
            <TextView android:id="@+id/widget_task6_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="Task title" android:textColor="@color/widget_light_text_primary" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_task6_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/widget_light_text_secondary" android:textSize="11sp" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_more_row"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_more_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/widget_light_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All caught up for today"
            android:textColor="@color/widget_light_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
